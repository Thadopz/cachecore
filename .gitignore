# IDE / local workspace
.vscode/
*.code-workspace
.github/

# Local context / scratch files
summary.md
query
$block
$mutex

# Temporary documents
*.docx
~$*.docx

# Local environment config
.env
.env.*
*.local.json
*.local.yaml
*.local.yml
config.local.*

# Build outputs
*.exe
.gocache/
.gocache-linux/
.gotmp-linux/
tmp-render/

# Generated profiles
profile*.pb.gz
profile*.svg

# Generated test and benchmark artifacts
test-logs/
perf/test-logs/

# Generated local perf outputs kept outside test-logs
perf/*.exe
perf/*.log
perf/*.txt
perf/scenario-*.log
perf/dynamic-window*.log

# Keep perf source scripts and checked-in reports
!perf/README.md
!perf/*.ps1
!perf/*.js
!perf/*.md
!perf/*_test.go
